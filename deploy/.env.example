# ─── Core ─────────────────────────────────────────────────────────────────────

# Domain used to build control-plane hostnames, e.g. traefik-admin.<BASE_DOMAIN>. (required)
BASE_DOMAIN=example.com

# Runtime environment. Use "production" in prod, "development" for local dev.
APP_ENV=production

# Host and port the FastAPI process listens on inside the container.
API_HOST=0.0.0.0
API_PORT=8000

# ASGI root-path / path prefix when the API is served behind a reverse-proxy strip (e.g. /api).
API_ROOT_PATH=/api

# Public-facing URL of the API as seen by browsers. Used for OAuth callback construction.
# Dev override: http://localhost:8001
PUBLIC_BASE_URL=https://traefik-admin.example.com

# Comma-separated list of origins allowed by CORS. Must include the UI origin.
# Dev override: http://localhost:5173
CORS_ALLOWED_ORIGINS=https://traefik-admin.example.com

# ACME / certificates
# Email address registered with Let's Encrypt for certificate expiry notices.
ACME_EMAIL=admin@example.com

# ─── Database / Redis ─────────────────────────────────────────────────────────

# Password for the "control" PostgreSQL user. (required)
POSTGRES_PASSWORD=change-me

# Full SQLAlchemy DSN used by the API. Constructed from POSTGRES_PASSWORD in docker-compose.
# Override here only if you use an external database.
DATABASE_URL=postgresql+psycopg://control:change-me@postgres:5432/traefik_control

# Redis connection string used for caching and session storage.
REDIS_URL=redis://redis:6379

# ─── Session / cookies ────────────────────────────────────────────────────────

# Secret key used to sign session cookies. Must be at least 16 chars; use 32+ random bytes in prod. (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Name of the session cookie set in the browser.
SESSION_COOKIE_NAME=tcp_session

# Session lifetime in seconds. Default: 604800 (7 days).
SESSION_MAX_AGE_SECONDS=604800

# ─── Auth providers ───────────────────────────────────────────────────────────

# Generic OIDC provider (e.g. Keycloak, Authentik). Only needed when using OIDC login.
OIDC_ISSUER=https://auth.example.com/realms/homelab
OIDC_CLIENT_ID=traefik-controlplane
OIDC_CLIENT_SECRET=change-me

# Google OAuth. Only needed when using "Continue with Google" login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Entra ID OAuth. Only needed when using "Continue with Microsoft" login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant ID: use "common" for multi-tenant, or your directory GUID / domain for single-tenant.
MICROSOFT_TENANT_ID=common

# Local username/password login. Set to false to force SSO-only.
LOCAL_AUTH_ENABLED=true

# Username for the bootstrapped admin account created on first startup.
INITIAL_ADMIN_USERNAME=admin

# Argon2 hash of the admin password. Generate with:
#   python scripts/hash_password.py 'yourpassword'
# Leave empty to disable the bootstrapped admin (not recommended unless an SSO admin exists). (required)
INITIAL_ADMIN_PASSWORD_HASH=

# ─── MFA + sensitive-action gates ─────────────────────────────────────────────

# Require TOTP/MFA verification before the apply-agent executes a plan. Default: false.
REQUIRE_MFA_FOR_APPLY=false

# Require users to type a confirmation phrase before applying a plan. Default: true.
REQUIRE_TYPED_CONFIRMATION_FOR_APPLY=true

# ─── Apply agent ──────────────────────────────────────────────────────────────

# Internal URL of the apply-agent service. Default points to the Docker service name.
AGENT_URL=http://apply-agent:7000

# Shared secret between the API and the apply-agent. Must match on both sides. (required)
AGENT_SHARED_TOKEN=change-this-long-random-token

# ─── Config repo (git adapter) ────────────────────────────────────────────────

# Absolute path (inside the container) to the git repo holding Traefik dynamic configs.
# Leave empty to disable file-based config persistence.
CONFIG_REPO_PATH=/srv/config-repo

# Git author identity used for automated commits to the config repo.
CONFIG_REPO_AUTHOR_NAME=traefik-control-plane
CONFIG_REPO_AUTHOR_EMAIL=control-plane@local

# ─── Git PR workflow (optional) ───────────────────────────────────────────────

# Enable the PR-based approval workflow instead of direct commits. Default: false.
GIT_PR_WORKFLOW_ENABLED=false

# Target branch for pull requests created by the workflow.
GIT_PR_TARGET_BRANCH=main

# Git remote name used when pushing PR branches.
GIT_PR_REMOTE=origin

# GitHub personal access token with repo scope. Only needed when GIT_PR_WORKFLOW_ENABLED=true.
GITHUB_API_TOKEN=

# GitHub repository in "owner/name" format, e.g. myorg/traefik-control-plane-config.
# Only needed when GIT_PR_WORKFLOW_ENABLED=true.
GITHUB_REPO=

# ─── DNS provider credentials ─────────────────────────────────────────────────

# Cloudflare API token with Zone:DNS:Edit permissions.
# Passed to Traefik as CF_DNS_API_TOKEN (ACME) and to the API as CLOUDFLARE_API_TOKEN (DNS adapter).
# Only needed when using the Cloudflare DNS resolver or the Cloudflare DNS provider.
CF_DNS_API_TOKEN=
# Note: the API reads this as CLOUDFLARE_API_TOKEN. docker-compose.yml maps CF_DNS_API_TOKEN -> CLOUDFLARE_API_TOKEN automatically.
CLOUDFLARE_API_TOKEN=

# AWS credentials for Route 53 ACME challenges and the Route 53 DNS adapter.
# Only needed when using the Route 53 DNS resolver or DNS provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# PowerDNS REST API. Only needed when using the PowerDNS DNS adapter.
POWERDNS_API_URL=
POWERDNS_API_KEY=

# ─── Traefik (for runtime ingestion) ─────────────────────────────────────────

# URL of the Traefik API used by the control plane to read live router/service state.
# Default points to the Docker service name on the dashboard port.
TRAEFIK_API_URL=http://traefik:8080
