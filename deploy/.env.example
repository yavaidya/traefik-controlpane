# Domain and routing
# This is only for control-plane hostnames (traefik-admin.<BASE_DOMAIN>).
# Managed app domains/zones are added from the UI and are not limited to this value.
BASE_DOMAIN=example.com

# ACME / certificates
ACME_EMAIL=admin@example.com

# DNS provider credentials (set only what your providers use)
# Resolver le_cf -> cloudflare
CF_DNS_API_TOKEN=
# Resolver le_route53 -> route53
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Database
POSTGRES_PASSWORD=change-me

# OIDC generic
OIDC_ISSUER=https://auth.example.com/realms/homelab
OIDC_CLIENT_ID=traefik-controlplane
OIDC_CLIENT_SECRET=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Local fallback auth
LOCAL_AUTH_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
# Use bcrypt/argon2 hash, not plaintext
INITIAL_ADMIN_PASSWORD_HASH=

# Internal service auth
AGENT_SHARED_TOKEN=change-this-long-random-token
